{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "cc65/Debug",
            "displayName": "cc65/Debug",
            "description": "cc65, with debug information, OPL2 only",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/cc65/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "RIVER_PCM": "OFF",
                "CC65_TARGET_SYSTEM": "rp6502"
            }
        },
        {
            "name": "cc65/Release",
            "displayName": "cc65/Release",
            "description": "cc65, optimized, OPL2 only",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/cc65/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "RIVER_PCM": "OFF",
                "CC65_TARGET_SYSTEM": "rp6502"
            }
        },
        {
            "name": "cc65/Release-OPL2",
            "displayName": "cc65/Release (OPL2 only)",
            "description": "cc65, optimized, without PCM assets or playback",
            "inherits": "cc65/Release",
            "binaryDir": "${sourceDir}/build/cc65/release-opl2",
            "cacheVariables": {
                "RIVER_PCM": "OFF"
            }
        },
        {
            "name": "cc65/Release-PCM",
            "displayName": "cc65/Release (OPL2 + PCM)",
            "description": "cc65, optimized, with optional PCM music and effects",
            "inherits": "cc65/Release",
            "binaryDir": "${sourceDir}/build/cc65/release-pcm",
            "cacheVariables": {
                "RIVER_PCM": "ON"
            }
        },
        {
            "name": "llvm-mos/Debug",
            "displayName": "llvm-mos/Debug",
            "description": "llvm-mos, with debug information",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/llvm-mos/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "LLVM_MOS_PLATFORM": "rp6502"
            }
        },
        {
            "name": "llvm-mos/Release",
            "displayName": "llvm-mos/Release",
            "description": "llvm-mos, optimized",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/llvm-mos/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "LLVM_MOS_PLATFORM": "rp6502"
            }
        },
        {
            "name": "basic",
            "displayName": "basic",
            "description": "BASIC",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/basic",
            "cacheVariables": {
                "RP6502_BASIC": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "cc65/Debug",
            "displayName": "cc65/Debug",
            "configurePreset": "cc65/Debug",
            "targets": ["all"]
        },
        {
            "name": "cc65/Release",
            "displayName": "cc65/Release",
            "configurePreset": "cc65/Release",
            "targets": ["all"]
        },
        {
            "name": "cc65/Release-OPL2",
            "displayName": "cc65/Release (OPL2 only)",
            "configurePreset": "cc65/Release-OPL2",
            "targets": ["all"]
        },
        {
            "name": "cc65/Release-PCM",
            "displayName": "cc65/Release (OPL2 + PCM)",
            "configurePreset": "cc65/Release-PCM",
            "targets": ["all"]
        },
        {
            "name": "llvm-mos/Debug",
            "displayName": "llvm-mos/Debug",
            "configurePreset": "llvm-mos/Debug",
            "targets": ["all"]
        },
        {
            "name": "llvm-mos/Release",
            "displayName": "llvm-mos/Release",
            "configurePreset": "llvm-mos/Release",
            "targets": ["all"]
        },
        {
            "name": "basic",
            "displayName": "basic",
            "configurePreset": "basic",
            "targets": ["all"]
        }
    ]
}
